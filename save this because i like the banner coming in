body {
    margin: 0;
    font-family: sans-serif;
}

.banner {
    background-color: black;
    color: white;
    padding: 20px;
    text-align: center;
    font-size: 1.2rem;

    /* animation styles */
    opacity: 0;
    transform: translateY(-100%);
    animation: slideFadeIn 1s ease-out forwards;
}

/* animation keyframes */
@keyframes slideFadeIn {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* Menu styling */
.menu {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 30px; /* Spacing between menu items */
    list-style: none; /* Remove default list styling */
    padding: 0;
    margin: 0;
}

.menu-item {
    width: 300px; /* Adjust for better visibility */
    height: 70px;
    font-size: 18px;
    font-weight: bold;
    background-color: black;
    color: white;
    border: 2px solid white;
    border-radius: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    justify-content: flex-start; /* Aligns content to the left */
    align-items: center;
    text-decoration: none;
    padding-left: 15px; /* Adds space to the left for the icon */
    position: relative;
    gap: 10px; /* Spacing between icon and text */
}

/* Add the flower image before each menu item */
.menu-item::before {
    content: "";
    display: inline-block;
    width: 55px; /* Adjust the size as needed */
    height: 55px; /* Adjust the size as needed */
    background-image: url('closed-flower.png');
    background-size: contain;
    background-repeat: no-repeat;
}

/* Change image on hover */
.menu-item:hover::before,
.menu-item:active::before {
    background-image: url('open-flower.png');
}
